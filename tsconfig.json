{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "client",
    "mcp",
    "bot",
    "server",
    "scripts",
    "tests",
    "supabase/functions/_shared",
    "vite.config.ts"
  ],
  "exclude": ["supabase/functions/monitor/index.ts"]
}

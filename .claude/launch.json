{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "review-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview:review"],
      "port": 8788
    },
    {
      "name": "review-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--host", "127.0.0.1", "--port", "5174"],
      "port": 5174,
      "env": {
        "REVIEW_API_TARGET": "http://127.0.0.1:8788",
        "VITE_SUPABASE_URL": "",
        "VITE_API_URL": "/api"
      }
    }
  ]
}

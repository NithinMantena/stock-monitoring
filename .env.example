# Never put API secrets in VITE_ variables.
TYPESAFE_API_KEY=
TYPESAFE_MONTHLY_BUDGET_USD=5
TYPESAFE_MODEL=jev-1.13.0
EODHD_API_KEY=
FMP_API_KEY=
# Explicit approved feed domains. Public HTTPS article/PDF hosts are resolved and checked separately.
ALLOWED_FEED_HOSTS=news.google.com,www.sec.gov,investors.progressive.com,investors.molinahealthcare.com
# Additional exact publisher hostnames for article text extraction.
ALLOWED_ARTICLE_HOSTS=
# Set false to restrict article retrieval to the explicit host list.
ALLOW_PUBLIC_ARTICLE_HOSTS=true
# Delivery stays disabled until a sender, recipient, and deliberate activation are provided.
ENABLE_EMAIL_DELIVERY=false
RESEND_API_KEY=
DIGEST_FROM=
DIGEST_TO=nithin@mantena.com
# Hosted only: public project URL / publishable key may be in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
# Edge Function secrets: OWNER_EMAIL, CRON_SECRET, MONITOR_OWNER_ID, APP_ORIGIN.
# Supabase provides SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY in the function runtime.
